// Build settings shared by the app and its helper.

MACOSX_DEPLOYMENT_TARGET = 26.0
SDKROOT = macosx
SWIFT_VERSION = 6.0
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
COPY_PHASE_STRIP = NO

// CI builds with GYRO_WARNINGS_AS_ERRORS=YES. Passing SWIFT_TREAT_WARNINGS_AS_ERRORS to
// xcodebuild directly would also reach GyroKit, which Xcode builds with warnings
// suppressed, and the two flags conflict.
SWIFT_TREAT_WARNINGS_AS_ERRORS = $(GYRO_WARNINGS_AS_ERRORS)
GCC_TREAT_WARNINGS_AS_ERRORS = $(GYRO_WARNINGS_AS_ERRORS)

// Signing. By default the app is signed to run locally (ad hoc).
//
// Ad hoc signing works, but macOS pins the privileged helper to the exact binary
// it first approved, so after changing the helper it won't start again until you
// click Repair Helper in the app or run scripts/reset-helper.sh. Signing with a Team ID (a free Apple Development
// certificate is enough) avoids this. To use yours, create Signing.local.xcconfig
// next to this file:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//     CODE_SIGN_IDENTITY = Apple Development
//
// That file is ignored by git.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
