// Build settings shared by the app and its helper.

MACOSX_DEPLOYMENT_TARGET = 26.0
SDKROOT = macosx
SWIFT_VERSION = 6.0
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
COPY_PHASE_STRIP = NO

// Signing. By default the app is signed to run locally (ad hoc).
// To sign with your own team, create Signing.local.xcconfig next to this file:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//     CODE_SIGN_IDENTITY = Apple Development
//
// That file is ignored by git.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
